---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUpdateFeed } from '../lib/updates';

const feed = await getUpdateFeed('en');
const totalEvents = feed.reduce((n, d) => n + d.events.length, 0);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Within a day, group pages under the change they were verified in.
const grouped = feed.map((day) => {
  const bySubject = new Map<string, typeof day.events>();
  for (const ev of day.events) {
    const list = bySubject.get(ev.subject) ?? [];
    list.push(ev);
    bySubject.set(ev.subject, list);
  }
  return { date: day.date, groups: [...bySubject.entries()] };
});
---

<BaseLayout
  title="Updates & verification log"
  description="Every date a page of this reference was verified against its primary sources — derived from the site's edit history, not asserted."
  alternates={{ en: '/updates', it: '/it/updates' }}
  ogImage="/og/updates.png"
>
  <h1 class="text-4xl font-semibold">Updates & verification log</h1>
  <p class="mt-3 max-w-2xl text-muted">
    Every page shows a "last verified" date; this log is the receipts. It lists all
    {totalEvents} occasions a page's verification date changed — meaning a human
    re-checked the content against the primary sources it cites — derived from the
    site's edit history.
  </p>

  <div class="mt-10 space-y-10">
    {
      grouped.map(({ date, groups }) => (
        <section>
          <h2 class="font-serif text-2xl">
            <time datetime={date}>{fmt(date)}</time>
          </h2>
          {groups.map(([subject, events]) => (
            <div class="mt-4 rounded-lg border border-line bg-white/60 p-4">
              <p class="text-sm font-medium">{subject}</p>
              <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                {events.map((ev) => (
                  <li>
                    <a href={ev.url} class="text-brand-700 hover:underline">
                      {ev.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>
