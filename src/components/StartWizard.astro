---
/**
 * "Start here" wizard. Every step lays out its options by situation; picking your
 * situation highlights the one that applies to you (and dims the rest), so each
 * step reads as a clear "here's your case, in context". The city selector scopes
 * each step's link to your comune.
 *
 * Progressive enhancement: the full per-situation comparison is server-rendered
 * and always useful without JS; a small vanilla-JS island (no framework) reveals
 * the situation/city controls and toggles the highlight. No innerHTML rebuilding —
 * JS only flips classes and link targets.
 */
import { citiesByRegion } from '../data/cities';
import { getLocale } from '../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'it' ? '/it' : '';
const groups = citiesByRegion();

const c =
  locale === 'it'
    ? {
        yourSituation: 'La tua situazione',
        showAll: 'Mostra tutte',
        cityLabel: 'La tua città',
        cityChoose: 'Scegli una città…',
        reset: 'Reimposta',
        youBadge: 'la tua situazione',
        bySituation: 'In base alla situazione',
        everyone: 'Vale per tutti',
        open: 'Apri la guida',
        hint: 'Scegli la tua situazione: in ogni passo verrà evidenziato ciò che ti riguarda.',
        browse: 'Percorso completo e tutte le città nella',
        citiesPage: 'pagina Città',
        situations: [
          { key: 'employed', label: 'Lavoratore dipendente', anagrafe: 'in base al contratto di lavoro', ssn: 'gratis — deriva dal lavoro' },
          { key: 'self-employed', label: 'Lavoratore autonomo', anagrafe: 'in base all’attività autonoma (partita IVA / iscrizione dell’attività)', ssn: 'gratis — tramite l’attività autonoma registrata' },
          { key: 'student', label: 'Studente', anagrafe: 'in base all’iscrizione a un corso di studi, con copertura sanitaria e risorse sufficienti', ssn: 'volontaria: 700 €/anno forfettari (o TEAM/privata per soggiorni brevi)' },
          { key: 'inactive', label: 'Non lavori (non attivo)', anagrafe: 'devi dimostrare risorse sufficienti + assicurazione sanitaria completa', ssn: 'non gratis: assicurazione privata oppure iscrizione volontaria da 2.000 €/anno' },
          { key: 'family', label: 'Familiare di cittadino UE', anagrafe: 'in base al legame familiare con il cittadino UE e alla sua condizione', ssn: 'tramite il familiare che raggiungi (i familiari non UE: carta di soggiorno)' },
        ],
        steps: [
          { key: 'codice-fiscale', title: 'Passo 1 · Codice fiscale', base: 'Gratuito e uguale in tutta Italia — si parte da qui.' },
          { key: 'iscrizione-anagrafica', title: 'Passo 2 · Residenza (anagrafe)', field: 'anagrafe', lead: 'Ti iscrivi all’anagrafe del Comune' },
          { key: 'servizio-sanitario', title: 'Passo 3 · Servizio sanitario (SSN)', field: 'ssn', lead: 'Iscrizione al SSN' },
          { key: 'identita-digitale', title: 'Passo 4 · Identità digitale (SPID e CIE)', base: 'SPID o CIE per i servizi pubblici online — uguale per tutti.' },
        ],
      }
    : {
        yourSituation: 'Your situation',
        showAll: 'Show all',
        cityLabel: 'Your city',
        cityChoose: 'Choose a city…',
        reset: 'Reset',
        youBadge: 'your situation',
        bySituation: 'By situation',
        everyone: 'Applies to everyone',
        open: 'Open the guide',
        hint: 'Pick your situation — each step highlights what applies to you.',
        browse: 'Full journey and all cities on the',
        citiesPage: 'Cities page',
        situations: [
          { key: 'employed', label: 'Employed', anagrafe: 'on the basis of your employment contract', ssn: 'free — follows from your job' },
          { key: 'self-employed', label: 'Self-employed', anagrafe: 'on the basis of your self-employment (partita IVA / business registration)', ssn: 'free — via your registered self-employment' },
          { key: 'student', label: 'Student', anagrafe: 'on the basis of study enrolment, with health cover and sufficient resources', ssn: 'voluntary: a flat €700/year (or EHIC/private for short stays)' },
          { key: 'inactive', label: 'Not working (inactive)', anagrafe: 'you must show sufficient resources + comprehensive health insurance', ssn: 'not free: private insurance, or voluntary enrolment from €2,000/year' },
          { key: 'family', label: 'Family of an EU citizen', anagrafe: 'on the basis of your family tie to the EU citizen and their status', ssn: 'via the family member you join (non-EU family: carta di soggiorno)' },
        ],
        steps: [
          { key: 'codice-fiscale', title: 'Step 1 · Codice fiscale', base: 'Free and identical everywhere in Italy — everyone starts here.' },
          { key: 'iscrizione-anagrafica', title: 'Step 2 · Residency (anagrafe)', field: 'anagrafe', lead: 'You register at your comune’s anagrafe' },
          { key: 'servizio-sanitario', title: 'Step 3 · Health service (SSN)', field: 'ssn', lead: 'You enrol in the SSN' },
          { key: 'identita-digitale', title: 'Step 4 · Digital identity (SPID & CIE)', base: 'SPID or the CIE for online public services — the same for everyone.' },
        ],
      };
---

<section data-start-wizard>
  <!-- Controls: revealed by JS (they only drive client-side highlight/links). -->
  <div
    data-wizard-controls
    hidden
    class="not-prose sticky top-0 z-10 rounded-xl border border-line bg-white/90 p-5 backdrop-blur"
  >
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-sm font-medium">{c.yourSituation}:</span>
      {
        c.situations.map((s) => (
          <button
            type="button"
            class="status-btn rounded-full border border-line px-3 py-1.5 text-sm hover:border-brand-300"
            data-status-btn={s.key}
          >
            {s.label}
          </button>
        ))
      }
      <button type="button" class="status-btn rounded-full border border-line px-3 py-1.5 text-sm text-muted hover:border-brand-300" data-status-btn="">
        {c.showAll}
      </button>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <label for="wizard-city" class="mr-1 text-sm font-medium">{c.cityLabel}:</label>
      <select
        id="wizard-city"
        data-wizard-city
        class="min-w-52 rounded-md border border-line bg-white px-3 py-1.5 text-sm focus:border-brand-500 focus:outline-none"
      >
        <option value="">{c.cityChoose}</option>
        {
          groups.map((g) => (
            <optgroup label={g.region.name}>
              {g.cities.map((ct) => (
                <option value={ct.slug}>
                  {ct.name} ({ct.province})
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
      <button type="button" data-wizard-reset class="text-sm text-muted underline underline-offset-2 hover:text-ink">
        {c.reset}
      </button>
    </div>
    <p class="mt-3 text-sm text-muted">{c.hint}</p>
  </div>

  <ol class="mt-6 grid gap-4">
    {
      c.steps.map((step) => (
        <li class="rounded-xl border border-line bg-white/60 p-5">
          <a
            href={`${prefix}/eu-citizens/residency/${step.key}`}
            data-step-link
            data-step-key={step.key}
            class="font-serif text-lg text-brand-700 hover:underline"
          >
            {step.title}
          </a>
          {step.field ? (
            <div class="mt-3">
              <p class="text-sm text-muted">
                {step.lead} <span class="font-medium text-ink">{c.bySituation.toLowerCase()}</span>:
              </p>
              <ul class="mt-2 space-y-1.5">
                {c.situations.map((s) => (
                  <li class="status-row flex items-baseline gap-2 rounded-md border border-transparent px-3 py-2 text-sm" data-status={s.key}>
                    <span class="min-w-40 shrink-0 font-medium">{s.label}</span>
                    <span>{step.field === 'anagrafe' ? s.anagrafe : s.ssn}</span>
                    <span class="you-badge ml-auto shrink-0 rounded-full bg-brand-500 px-2 py-0.5 text-xs font-medium text-white">
                      {c.youBadge}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <p class="mt-2 text-sm">
              {step.base} <span class="text-muted">· {c.everyone}</span>
            </p>
          )}
          <a href={`${prefix}/eu-citizens/residency/${step.key}`} data-step-link data-step-key={step.key} class="mt-3 inline-block text-sm text-brand-600 underline">
            {c.open} →
          </a>
        </li>
      ))
    }
  </ol>

  <p class="mt-4 text-sm text-muted">
    {c.browse} <a href={`${prefix}/cities`} class="underline hover:text-ink">{c.citiesPage}</a>.
  </p>

  <span data-wizard-prefix={prefix} hidden></span>
</section>

<style>
  .status-row { transition: opacity 0.15s ease, background-color 0.15s ease, border-color 0.15s ease; }
  .status-row.is-you { border-color: var(--color-brand-500); background: var(--color-brand-50); }
  .status-row.is-dim { opacity: 0.4; }
  .you-badge { display: none; }
  .status-row.is-you .you-badge { display: inline-block; }
  .status-btn.is-active { background: var(--color-brand-500); border-color: var(--color-brand-500); color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-start-wizard]').forEach((root) => {
    const controls = root.querySelector<HTMLElement>('[data-wizard-controls]');
    const prefix = root.querySelector<HTMLElement>('[data-wizard-prefix]')?.dataset.wizardPrefix || '';
    if (!controls) return;
    controls.hidden = false; // JS available → show the controls

    const btns = root.querySelectorAll<HTMLButtonElement>('[data-status-btn]');
    const rows = root.querySelectorAll<HTMLElement>('.status-row');
    const links = root.querySelectorAll<HTMLAnchorElement>('[data-step-link]');
    const city = root.querySelector<HTMLSelectElement>('[data-wizard-city]');

    const applyStatus = (status: string) => {
      btns.forEach((b) => b.classList.toggle('is-active', b.dataset.statusBtn === status && status !== ''));
      rows.forEach((r) => {
        const match = r.dataset.status === status;
        r.classList.toggle('is-you', status !== '' && match);
        r.classList.toggle('is-dim', status !== '' && !match);
      });
    };

    const applyCity = (slug: string) => {
      links.forEach((a) => {
        const key = a.dataset.stepKey!;
        a.href = slug ? `${prefix}/cities/${slug}/residency/${key}` : `${prefix}/eu-citizens/residency/${key}`;
      });
    };

    // Restore saved choices (shares the 'city' key with the site's city selector).
    let status = '';
    try {
      status = localStorage.getItem('wizard-situation') || '';
      const savedCity = localStorage.getItem('city');
      if (savedCity && city) city.value = savedCity;
    } catch {
      /* ignore */
    }
    applyStatus(status);
    if (city) applyCity(city.value);

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        status = b.dataset.statusBtn || '';
        try {
          if (status) localStorage.setItem('wizard-situation', status);
          else localStorage.removeItem('wizard-situation');
        } catch {
          /* ignore */
        }
        applyStatus(status);
      }),
    );

    city?.addEventListener('change', () => {
      try {
        if (city.value) localStorage.setItem('city', city.value);
      } catch {
        /* ignore */
      }
      applyCity(city.value);
    });

    root.querySelector<HTMLButtonElement>('[data-wizard-reset]')?.addEventListener('click', () => {
      status = '';
      if (city) city.value = '';
      try {
        localStorage.removeItem('wizard-situation');
      } catch {
        /* ignore */
      }
      applyStatus('');
      applyCity('');
    });
  });
</script>
