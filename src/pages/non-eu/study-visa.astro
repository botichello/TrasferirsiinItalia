---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Orientation page on the study visa (university route). Facts verified
// 2026-07-22 against the fetched official sources below.
const sources = [
  { title: 'MUR — Procedure per studenti internazionali, a.a. 2026-2027 e 2027-2028 (PDF, Universitaly)', url: 'https://universitaly-private.cineca.it/uploads/universitaly-pubblico/Circolare_2026-2027_studenti_internazionali.pdf' },
  { title: 'Normattiva — DPR 394/1999, art. 14 (lavoro part-time e conversione)', url: 'https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.del.presidente.della.repubblica:1999-08-31;394~art14!vig=' },
  { title: 'Normattiva — D.Lgs. 286/1998, art. 39-bis.1 (permesso ricerca lavoro post-laurea)', url: 'https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:1998-07-25;286~art39bis.1!vig=' },
  { title: "Ambasciata d'Italia Tel Aviv — Study visas, a.a. 2026-2027", url: 'https://ambtelaviv.esteri.it/en/servizi-consolari-e-visti/servizi-per-il-cittadino-straniero/visti/visti-studio-procedura-per-limmatricolazione-e-visti-anno-accademico-2025-2026/' },
  { title: 'Normattiva — L. 213/2023, art. 1 commi 240-241 (contributo SSN studenti)', url: 'https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:legge:2023-12-30;213~art1!vig=' },
];
const checklist = [
  'Universitaly pre-enrolment validated by your university (one course, one university, per academic year)',
  '€10,179.85 for the academic year (≈ €848.25/month, a.y. 2026–27) from lawful, traceable sources — yours or family up to the 4th degree; a scholarship counts only once actually awarded',
  'Suitable accommodation (mere eligibility for a residence-hall place is not accepted)',
  'Health insurance valid in Italy with no caps on urgent hospitalisation (or a bilateral-agreement declaration)',
  'Funds for repatriation or a return ticket, on top of the subsistence amount',
  'Your qualification: a secondary title after 12+ years of schooling, or the CIMEA attestation / Dichiarazione di Valore for degree-level entry',
];
---

<BaseLayout
  title="Italy's student visa (university)"
  description="The type D study visa: Universitaly pre-enrolment, the €10,179.85 subsistence figure, the 20-hour work allowance, and the post-graduation job-search permit."
  alternates={{ en: '/non-eu/study-visa', it: '/it/non-eu/study-visa' }}
  ogImage="/og/study-visa.png"
  citations={sources}
>
  <nav class="mb-6 text-sm text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="px-1">/</span>
    <a href="/non-eu" class="hover:text-ink">Non-EU citizens</a>
    <span class="px-1">/</span>
    <span class="text-ink">Study visa</span>
  </nav>

  <div class="prose">
    <h1>Italy's student visa (university)</h1>
    <p>
      Non-EU students staying over 90 days need the type D
      <strong>"STUDIO – Immatricolazione Università"</strong> visa. The whole
      route runs through one portal — <strong>Universitaly</strong> — and one
      annually reissued rulebook, the MUR circular for international students
      (currently the a.y. 2026–27/2027–28 edition). Facts verified
      <time datetime="2026-07-22">22 July 2026</time>; orientation, not legal advice.
    </p>

    <h2>The requirements</h2>
    <ul>
      {checklist.map((item) => <li>{item}</li>)}
    </ul>

    <h2>How it works</h2>
    <ol>
      <li><strong>Pre-enrol on Universitaly</strong>; your university validates the application on the portal — the consulate issues no visa without that validation.</li>
      <li>Apply at the consulate (for a.y. 2026/27: by <strong>30 November 2026</strong>; fingerprints required for national visas since January 2025, with some nationalities exempt). The visa is issued for <strong>365 days, multiple entries</strong>.</li>
      <li>Within <strong>8 working days of arrival</strong>, request the <strong>permesso di soggiorno per studio</strong> at the Questura (postal kit or university help desk).</li>
      <li><strong>Renew yearly with academic progress</strong>: at least one exam passed in year one, two per year after (one suffices for grave documented reasons). Renewals run through further degree levels plus one extra year.</li>
    </ol>

    <h2>Working, healthcare, and staying on</h2>
    <ul>
      <li><strong>Work</strong>: the study permit itself allows employee work up to <strong>20 hours a week</strong>, max 1,040 hours a year (DPR 394/1999, art. 14).</li>
      <li><strong>Healthcare</strong>: students may enrol in the SSN voluntarily from <strong>€700 a year</strong> (L. 213/2023), paid via F24 — see our <a href="/eu-citizens/residency/servizio-sanitario">SSN guide</a>.</li>
      <li><strong>After graduation</strong>: convert to a work permit, or take the <strong>9–12 month job-search / entrepreneurship permit</strong> (TU art. 39-bis.1) available to graduates of Italian degrees — itself convertible to work.</li>
      <li>Years on a study permit build toward <a href="/non-eu/long-term-residence">long-term residence</a> only in nuanced ways — you cannot apply while residing for study.</li>
    </ul>
  </div>

  <section class="mt-10 rounded-lg border border-line bg-surface/60 p-6">
    <h2 class="font-serif text-xl">Sources</h2>
    <p class="mt-1 text-sm text-muted">
      Primary, official sources this page is based on — each fetched and checked on 22 July 2026.
    </p>
    <ul class="mt-3 space-y-1 text-sm">
      {
        sources.map((s) => (
          <li>
            <a href={s.url} class="text-brand-700 underline underline-offset-2">
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
