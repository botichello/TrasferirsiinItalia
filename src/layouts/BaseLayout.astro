---
import '../styles/global.css';
import { getLocale, localizePath, ui } from '../i18n/ui';
import { findByPath, parentOf, pathOf, titleOf } from '../lib/orientation';
import { getFirstPublished } from '../lib/updates';
import { breadcrumbNode, ids, ref, type SchemaNode } from '../lib/schema';
// Vercel Web Analytics. Cookieless and first-party: the script is served from
// /_vercel/insights/ on our own origin, so no third-party host is contacted —
// which is why it needs no consent banner and does not weaken the site's
// privacy posture. It is the one script the otherwise zero-JS pages carry.
import Analytics from '@vercel/analytics/astro';
import { SEARCH_INDEXING } from '../data/site';
// Hashed URLs of the two latin font files used above the fold, for preload.
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatinUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Override the canonical URL (e.g. a region page that consolidates to the
   *  national guide when it has no substantive region-specific content). */
  canonical?: string;
  /** Root-relative paths to the en/it twins of this page, for hreflang. */
  alternates?: { en: string; it: string };
  /** Open Graph object type — 'article' for guide pages. */
  ogType?: 'website' | 'article';
  /** Last-modified date, emitted as article:modified_time for articles. */
  modified?: Date;
  /** Keep the page out of search indexes (e.g. the client-side /search). */
  noindex?: boolean;
  /** Root-relative path of a page-specific social card (defaults to the site card). */
  ogImage?: string;
  /** Official sources an orientation page cites, emitted as schema.org citations. */
  citations?: { title: string; url: string }[];
  /** Page-specific JSON-LD nodes, merged into this page's single @graph. */
  schema?: SchemaNode[];
  /** ISO date the page first shipped (see getFirstPublished). */
  datePublished?: string;
}
const {
  title,
  description,
  canonical: canonicalOverride,
  alternates,
  ogType = 'website',
  modified,
  noindex = false,
  ogImage: ogImagePath = '/og-default.png',
  citations = [],
  schema = [],
  datePublished: datePublishedProp,
} = Astro.props;
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Trasferirsi in Italia';

// Crawler directives.
//
// `noindex, follow` rather than a bare `noindex`: the page stays out of the
// index but its links keep being crawled, which is what /search and /404 need —
// they are reachable pages that lead somewhere.
//
// The indexable form spells out the three preview limits because the defaults
// are not neutral in Europe. Under the EU copyright directive Google shows
// publishers in member states a shortened snippet and a thumbnail-sized image
// unless the page opts in, and a truncated snippet is a bad outcome for a page
// whose value is a specific, dated fact. `max-snippet:-1` and
// `max-image-preview:large` opt in; the video limit is stated for completeness
// on a site that has no video, so a future embed does not silently inherit a
// restriction nobody chose.
const robots =
  noindex || !SEARCH_INDEXING
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// SERP/tab title. Google renders roughly 600px of title text, which is about 60
// characters at the widths this site's words fall in; past that the tail is
// replaced with an ellipsis or the whole title is rewritten. The brand suffix
// costs 24 characters, so it is appended only when the page title leaves room —
// otherwise the suffix would push the words that distinguish this page from
// every other one off the end of the snippet. `check:seo` holds the ceiling.
const brandSuffix = ` · ${siteName}`;
const headTitle = (title + brandSuffix).length <= 60 ? title + brandSuffix : title;

const locale = getLocale(Astro.url);
const t = ui[locale];

const ogImage = new URL(ogImagePath, Astro.site).href;
const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';

// ---- Structured data -------------------------------------------------------
// One script, one @graph, every node addressable by @id. See src/lib/schema.ts
// for why the ids exist at all.
const siteHref = Astro.site!.href;
const orgId = ids.organization(siteHref);
const siteId = ids.website(siteHref);
const webPageId = ids.webPage(canonical);

const organization: SchemaNode = {
  '@type': 'Organization',
  '@id': orgId,
  name: siteName,
  url: siteHref,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description:
    'A free, source-cited reference for relocating to Italy, covering the EU/EEA residency journey at national, regional, and comune level.',
};

// WebSite with a SearchAction: tells search engines and AI agents that the site
// is searchable at /search?q=… (the search page reads ?q on load).
const website: SchemaNode = {
  '@type': 'WebSite',
  '@id': siteId,
  name: siteName,
  url: siteHref,
  inLanguage: ['en', 'it'],
  publisher: ref(orgId),
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL('/search?q={search_term_string}', Astro.site).href,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Orientation pages (src/pages/*.astro outside the content collections) get an
// Article + BreadcrumbList, auto-detected from the registry so the structured
// dateModified always equals the date printed on the page. Guides pass their
// own nodes in via `schema`.
const orientationEntry = findByPath(Astro.url.pathname);
// Guides pass their own; an orientation page's is looked up here from the same
// git-derived history that powers /updates. The registry keys only the English
// file, so the Italian twin simply goes without rather than borrowing a date
// that was never measured for it.
const datePublished =
  datePublishedProp ??
  (orientationEntry ? getFirstPublished(orientationEntry.en.replace(/^src\//, '')) : undefined);
const orientationNodes: SchemaNode[] = orientationEntry
  ? [
      {
        '@type': 'Article',
        '@id': ids.article(canonical),
        headline: title,
        description,
        url: canonical,
        inLanguage: locale,
        dateModified: orientationEntry.lastVerified,
        ...(datePublished && { datePublished }),
        isAccessibleForFree: true,
        mainEntityOfPage: ref(webPageId),
        publisher: ref(orgId),
        isPartOf: ref(siteId),
        ...(citations.length > 0 && {
          citation: citations.map((s) => ({ '@type': 'WebPage', name: s.title, url: s.url })),
        }),
      },
      breadcrumbNode(canonical, [
        { name: t.guide.home, path: locale === 'en' ? '/' : '/it' },
        ...(parentOf(orientationEntry)
          ? [
              {
                name: titleOf(parentOf(orientationEntry)!, locale),
                path: localizePath(pathOf(parentOf(orientationEntry)!), locale),
              },
            ]
          : []),
        { name: titleOf(orientationEntry, locale), path: localizePath(pathOf(orientationEntry), locale) },
      ].map((item) => ({ name: item.name, url: new URL(item.path, Astro.site).href }))),
    ]
  : [];

const extraNodes = [...orientationNodes, ...schema];

// The page node itself, wired to whatever the page turned out to contain. The
// two pointers are derived rather than passed: a caller that adds a breadcrumb
// or a HowTo should not also have to remember to announce it here, because the
// version it forgets is the one that ships.
const primary = extraNodes.find((n) =>
  ['Article', 'HowTo', 'TechArticle'].includes(String(n['@type'])),
);
const breadcrumb = extraNodes.find((n) => n['@type'] === 'BreadcrumbList');
const dateModified = modified?.toISOString().slice(0, 10) ?? orientationEntry?.lastVerified;

const webPage: SchemaNode = {
  '@type': 'WebPage',
  '@id': webPageId,
  url: canonical,
  name: title,
  description,
  inLanguage: locale,
  isPartOf: ref(siteId),
  ...(dateModified && { dateModified }),
  ...(datePublished && { datePublished }),
  ...(breadcrumb && { breadcrumb: ref(String(breadcrumb['@id'])) }),
  ...(primary && { mainEntity: ref(String(primary['@id'])) }),
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, webPage, ...extraNodes],
};

const homeHref = locale === 'en' ? '/' : '/it';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#265840" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171613" />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Trasferirsi in Italia — verification updates"
      href="/updates.xml"
    />

    <title>{headTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site).href} />
          <link rel="alternate" hreflang="it" href={new URL(alternates.it, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    {
      ogType === 'article' && modified && (
        <meta property="article:modified_time" content={modified.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <div
      class="h-[3px] w-full"
      style="background: linear-gradient(90deg, #008c45 0 33.4%, #f1f2ec 33.4% 66.7%, #cd212a 66.7% 100%);"
      aria-hidden="true"
    >
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-fill focus:px-3 focus:py-2 focus:text-onfill"
    >
      {t.skip}
    </a>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-5 py-4">
        <a href={homeHref} class="font-serif text-lg font-semibold text-ink">
          Trasferirsi <span class="text-link">in Italia</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm print:hidden" aria-label="Primary">
          {t.nav.map((item) => (
            <a href={item.href} class="text-muted hover:text-ink">{item.label}</a>
          ))}
          <a
            href={t.switchHref}
            class="rounded-full border border-line px-2 py-0.5 text-muted hover:border-brand-300 hover:text-brand-700"
            hreflang={locale === 'en' ? 'it' : 'en'}
          >
            {t.switchLabel}
          </a>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-8 text-sm text-muted">
        <nav class="mb-4 flex flex-wrap gap-x-4 gap-y-1 print:hidden" aria-label="Footer">
          {t.footerNav.map((item) => (
            <a href={item.href} class="hover:text-ink">{item.label}</a>
          ))}
        </nav>
        <p>{t.disclaimer}</p>
        <p class="mt-2">© {new Date().getFullYear()} Trasferirsi in Italia</p>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
