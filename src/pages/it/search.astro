---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

{/* noindex: come /search, i risultati sono renderizzati lato client. */}
<BaseLayout
  title="Cerca"
  description="Cerca tra guide, regioni, città e glossario."
  noindex
>
  <h1 class="text-4xl font-semibold">Cerca</h1>
  <p class="mt-3 text-muted">
    Cerca guide, regioni, città e voci del glossario. Suggerimento: prova il nome di
    una città (es. "Firenze") o un passo ("codice fiscale", "residenza", "sanità").
  </p>

  <form class="mt-6" role="search" data-search-form>
    <input
      type="search"
      name="q"
      data-search-input
      placeholder="Cerca…"
      autocomplete="off"
      aria-label="Cerca"
      class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-base focus:border-brand-500 focus:outline-none"
    />
  </form>

  <p class="mt-4 text-sm text-muted" data-search-status>Caricamento dell'indice…</p>
  <ul class="mt-4 divide-y divide-line" data-search-results></ul>

  <noscript>
    <p class="mt-4 text-muted">
      La ricerca richiede JavaScript. In alternativa sfoglia per
      <a href="/it/cities" class="text-link underline">città</a> o
      <a href="/it/regions" class="text-link underline">regione</a>.
    </p>
  </noscript>
</BaseLayout>

<script>
  type Entry = { title: string; url: string; type: string; text: string };

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const list = document.querySelector<HTMLUListElement>('[data-search-results]');

  let entries: Entry[] = [];

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const fold = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{M}/gu, '')
      .replace(/['’]/g, '');

  function score(entry: Entry, tokens: string[]): number {
    const title = fold(entry.title);
    const hay = fold(`${entry.title} ${entry.text} ${entry.type}`);
    let s = 0;
    for (const t of tokens) {
      if (!hay.includes(t)) return -1;
      if (title.includes(t)) s += 2;
      else s += 1;
    }
    return s;
  }

  function render(query: string) {
    if (!list || !status) return;
    const tokens = fold(query).split(/\s+/).filter(Boolean);
    if (tokens.length === 0) {
      list.innerHTML = '';
      status.textContent = `Digita per cercare tra ${entries.length} pagine.`;
      return;
    }
    const hits = entries
      .map((e) => ({ e, s: score(e, tokens) }))
      .filter((x) => x.s >= 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 30);

    status.textContent = `${hits.length} risultat${hits.length === 1 ? 'o' : 'i'}`;
    list.innerHTML = hits
      .map(
        ({ e }) => `
        <li class="py-3">
          <a href="${e.url}" class="font-medium text-brand-700 hover:underline">${escape(e.title)}</a>
          <div class="text-sm text-muted">${escape(e.type)}</div>
        </li>`,
      )
      .join('');
  }

  async function init() {
    try {
      const res = await fetch('/search-index.json');
      entries = await res.json();
      if (status) status.textContent = `Digita per cercare tra ${entries.length} pagine.`;
      const params = new URLSearchParams(location.search);
      const q = params.get('q');
      if (q && input) {
        input.value = q;
        render(q);
      }
    } catch {
      if (status) status.textContent = "Impossibile caricare l'indice di ricerca.";
    }
  }

  input?.addEventListener('input', () => render(input.value));
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) render(input.value);
  });
  init();
</script>
