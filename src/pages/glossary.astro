---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glossary } from '../data/glossary';

const url = new URL('/glossary', Astro.site).href;
const schema = {
  '@type': 'DefinedTermSet',
  '@id': `${url}#glossary`,
  name: 'Trasferirsi in Italia — Glossary',
  description: 'Definitions of the Italian bureaucratic terms newcomers meet when relocating to Italy.',
  hasDefinedTerm: glossary.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${url}#${t.slug}`,
    name: t.term,
    description: t.en,
    inDefinedTermSet: { '@id': `${url}#glossary` },
  })),
};
---

<BaseLayout
  title="Glossary"
  description="The Italian bureaucratic terms you'll meet when relocating — codice fiscale, anagrafe, SSN, SPID, PEC — defined in plain English."
  alternates={{ en: '/glossary', it: '/it/glossary' }}
  ogImage="/og/glossary.png"
  schema={[schema]}
>

  <div class="prose">
    <h1>Glossary</h1>
    <p>
      The terms you'll meet constantly while settling in Italy, defined in plain
      English. Each links to the guide that covers it in full.
    </p>
  </div>

  <dl class="mt-8 space-y-6">
    {
      glossary.map((t) => (
        <div id={t.slug} class="rounded-xl border border-line bg-surface/60 p-5 scroll-mt-20">
          <dt class="flex flex-wrap items-baseline gap-3">
            <a href={`#${t.slug}`} class="font-serif text-lg text-ink hover:text-brand-700">
              {t.term}
            </a>
          </dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-muted">
            {t.en}
            {t.guide && (
              <>
                {' '}
                <a href={t.guide} class="whitespace-nowrap text-link underline">
                  Read the guide →
                </a>
              </>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>
