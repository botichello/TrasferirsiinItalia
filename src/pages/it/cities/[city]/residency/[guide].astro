---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../../../layouts/GuideLayout.astro';
import { cities, getCity } from '../../../../../data/cities';
import { getRegion } from '../../../../../data/regions';
import { guideSlug } from '../../../../../lib/guides';

export async function getStaticPaths() {
  const SSN = 'servizio-sanitario';
  const guides = await getCollection('guides', ({ data }) => data.lang === 'it');
  const regionNotes = await getCollection('regionNotes');
  const comuneNotes = await getCollection('comuneNotes');

  return cities.flatMap((city) =>
    guides.map((entry) => {
      const slug = guideSlug(entry);
      const note =
        slug === SSN
          ? regionNotes.find(
              (n) => n.data.region === city.region && n.data.guide === slug && n.data.lang === 'it',
            )
          : comuneNotes.find(
              (n) => n.data.city === city.slug && n.data.guide === slug && n.data.lang === 'it',
            );
      return {
        params: { city: city.slug, guide: slug },
        props: { entry, citySlug: city.slug, note },
      };
    }),
  );
}

const SSN = 'servizio-sanitario';
const { entry, citySlug, note } = Astro.props;
const city = getCity(citySlug)!;
const region = getRegion(city.region)!;
const slug = guideSlug(entry);
const isSSN = slug === SSN;

const { Content } = await render(entry);
const NoteContent = note ? (await render(note)).Content : null;

const canonical = isSSN
  ? new URL(`/it/regions/${region.slug}/residency/${SSN}`, Astro.site).href
  : note
    ? undefined
    : new URL(`/it/eu-citizens/residency/${slug}`, Astro.site).href;

const place = {
  kind: 'city' as const,
  name: city.name,
  regionName: region.name,
  navBase: `/it/cities/${city.slug}/residency`,
  citySlug: city.slug,
};

const localHeading = isSSN ? `In ${region.name}` : `A ${city.name}`;

const fallbacks: Record<string, string> = {
  'codice-fiscale': `Il codice fiscale si ottiene allo stesso modo in tutta Italia presso l'Agenzia delle Entrate: non esiste una procedura specifica per ${city.name}. L'unico elemento locale è quale ufficio territoriale dell'Agenzia delle Entrate serve il tuo indirizzo (provincia di ${city.province}); usa il servizio "Trova l'ufficio" o presentati in qualsiasi ufficio. La procedura completa è nella guida nazionale qui sopra.`,
  'iscrizione-anagrafica': `L'iscrizione anagrafica è gestita dal Comune di ${city.name} tramite il suo Ufficio Anagrafe, secondo le regole nazionali qui sopra, ma ufficio, prenotazione e moduli sono locali. Consulta il sito del Comune di ${city.name}. Non abbiamo ancora una guida verificata specifica per ${city.name} su questo passo.`,
  'identita-digitale': `SPID e CIE sono nazionali. Lo SPID si ottiene interamente online da un gestore accreditato, senza passaggi specifici per ${city.name}; la CIE — che funge anche da identità digitale — è rilasciata dall'Ufficio Anagrafe del Comune di ${city.name} su appuntamento, secondo la procedura nazionale uniforme qui sopra. L'unico elemento locale è la prenotazione dell'appuntamento CIE in Comune.`,
  'conto-corrente': `Le regole bancarie sono nazionali: il diritto al conto di base, i documenti richiesti e le soglie dell'imposta di bollo sono uguali in tutta Italia. Non esiste una procedura specifica per ${city.name}; scegli semplicemente una banca con una filiale (o un'offerta online) comoda per te a ${city.name}.`,
  'patente-di-guida': `Validità e conversione della patente seguono regole nazionali. L'unico elemento locale è quale Ufficio della Motorizzazione Civile serve la provincia di ${city.province} — prenota e presenta lì la pratica di conversione, secondo la procedura nazionale uniforme qui sopra.`,
  'residenza-fiscale': `La residenza fiscale è definita dalla legge nazionale (art. 2 TUIR) — nulla è specifico di ${city.name}. L'unico elemento locale è quale ufficio territoriale dell'Agenzia delle Entrate serve il tuo indirizzo per le pratiche in presenza; le dichiarazioni sono nazionali e online.`,
  'familiari-non-ue': `La carta di soggiorno per familiari non UE segue la procedura nazionale uniforme qui sopra. A livello locale, la domanda si presenta alla Questura della provincia di ${city.province}; controlla il suo sito per prenotazioni o kit postale.`,
};
const localFallback = fallbacks[slug] ?? '';
---

<GuideLayout
  entry={entry}
  place={place}
  localNote={note}
  localHeading={localHeading}
  localFallback={localFallback}
  canonical={canonical}
>
  <Content />
  {NoteContent && <NoteContent slot="local-note" />}
</GuideLayout>
