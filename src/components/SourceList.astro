---
/**
 * Renders the primary sources for a page. Required by the content schema, so
 * this list is never empty on a published guide.
 */
import { getLocale, ui } from '../i18n/ui';
import archives from '../data/archives.json';

interface Source {
  title: string;
  url: string;
  accessed: Date;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
const locale = getLocale(Astro.url);
const t = ui[locale].guide;
const fmt = (d: Date) =>
  d.toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
const archMap = archives as Record<string, { archived: string; timestamp: string }>;
const tsDate = (ts: string) =>
  ts && ts.length >= 8 ? `${ts.slice(0, 4)}-${ts.slice(4, 6)}-${ts.slice(6, 8)}` : '';
const items = sources.map((s) => {
  const a = archMap[s.url];
  return { ...s, archived: a?.archived ?? null, archDate: a ? tsDate(a.timestamp) : '' };
});
---

<section class="mt-12 rounded-lg border border-line bg-surface/60 p-6">
  <h2 class="font-serif text-xl">{t.sources}</h2>
  <p class="mt-1 text-sm text-muted">{t.sourcesIntro}</p>
  <ol class="mt-4 space-y-3 text-sm">
    {
      items.map((s) => (
        <li>
          <a
            href={s.url}
            class="text-link underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            {s.title}
          </a>
          <span class="text-muted"> — {t.checkedOn} {fmt(s.accessed)}</span>
          {s.archived && (
            <span class="text-muted">
              {' · '}
              <a
                href={s.archived}
                class="underline underline-offset-2 hover:text-ink"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.archived}
                {s.archDate ? ` ${s.archDate}` : ''}
              </a>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</section>
