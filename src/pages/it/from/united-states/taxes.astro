        {
          reports.map(([name, threshold, where, due]) => (
            <tr class="border-b border-line align-top">
              <td class="py-2.5 pr-4 font-medium">{name}</td>
              <td class="py-2.5 pr-4 text-muted">{threshold}</td>
              <td class="py-2.5 pr-4 text-muted">{where}</td>
