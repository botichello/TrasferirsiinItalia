---
import '../styles/global.css';
import { getLocale, ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Override the canonical URL (e.g. a region page that consolidates to the
   *  national guide when it has no substantive region-specific content). */
  canonical?: string;
  /** Root-relative paths to the en/it twins of this page, for hreflang. */
  alternates?: { en: string; it: string };
  /** Open Graph object type — 'article' for guide pages. */
  ogType?: 'website' | 'article';
  /** Last-modified date, emitted as article:modified_time for articles. */
  modified?: Date;
  /** Keep the page out of search indexes (e.g. the client-side /search). */
  noindex?: boolean;
}
const {
  title,
  description,
  canonical: canonicalOverride,
  alternates,
  ogType = 'website',
  modified,
  noindex = false,
} = Astro.props;
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Trasferirsi in Italia';

const locale = getLocale(Astro.url);
const t = ui[locale];

const ogImage = new URL('/og-default.png', Astro.site).href;
const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site?.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description:
    'A free, source-cited reference for relocating to Italy, covering the EU/EEA residency journey at national, regional, and comune level.',
};

// WebSite schema with a SearchAction: tells search engines and AI agents that
// the site is searchable at /search?q=… (the search page reads ?q on load).
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.href,
  inLanguage: ['en', 'it'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL('/search?q={search_term_string}', Astro.site).href,
    },
    'query-input': 'required name=search_term_string',
  },
};

const homeHref = locale === 'en' ? '/' : '/it';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#265840" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site).href} />
          <link rel="alternate" hreflang="it" href={new URL(alternates.it, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />
    {
      ogType === 'article' && modified && (
        <meta property="article:modified_time" content={modified.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
      is:inline
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
    >
      {t.skip}
    </a>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-5 py-4">
        <a href={homeHref} class="font-serif text-lg font-semibold text-ink">
          Trasferirsi <span class="text-brand-600">in Italia</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Primary">
          {t.nav.map((item) => (
            <a href={item.href} class="text-muted hover:text-ink">{item.label}</a>
          ))}
          <a
            href={t.switchHref}
            class="rounded-full border border-line px-2 py-0.5 text-muted hover:border-brand-300 hover:text-brand-700"
            hreflang={locale === 'en' ? 'it' : 'en'}
          >
            {t.switchLabel}
          </a>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-8 text-sm text-muted">
        <nav class="mb-4 flex flex-wrap gap-x-4 gap-y-1" aria-label="Footer">
          {t.footerNav.map((item) => (
            <a href={item.href} class="hover:text-ink">{item.label}</a>
          ))}
        </nav>
        <p>{t.disclaimer}</p>
        <p class="mt-2">© {new Date().getFullYear()} Trasferirsi in Italia</p>
      </div>
    </footer>
  </body>
</html>
