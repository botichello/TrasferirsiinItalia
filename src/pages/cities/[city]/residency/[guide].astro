---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../../layouts/GuideLayout.astro';
import { cities, getCity } from '../../../../data/cities';
import { getRegion } from '../../../../data/regions';

export async function getStaticPaths() {
  // Note: top-level consts are not in scope inside getStaticPaths (Astro runs
  // it in isolation), so keep this local.
  const SSN = 'servizio-sanitario';
  const guides = await getCollection('guides', ({ data }) => data.lang === 'en');
  const regionNotes = await getCollection('regionNotes');
  const comuneNotes = await getCollection('comuneNotes');

  return cities.flatMap((city) =>
    guides.map((entry) => {
      // SSN varies by region; the other steps vary by comune.
      const note =
        entry.id === SSN
          ? regionNotes.find(
              (n) => n.data.region === city.region && n.data.guide === entry.id && n.data.lang === 'en',
            )
          : comuneNotes.find(
              (n) => n.data.city === city.slug && n.data.guide === entry.id && n.data.lang === 'en',
            );
      return {
        params: { city: city.slug, guide: entry.id },
        props: { entry, citySlug: city.slug, note },
      };
    }),
  );
}

const SSN = 'servizio-sanitario';
const { entry, citySlug, note } = Astro.props;
const city = getCity(citySlug)!;
const region = getRegion(city.region)!;
const isSSN = entry.id === SSN;

const { Content } = await render(entry);
const NoteContent = note ? (await render(note)).Content : null;

// Canonical strategy:
// - SSN is identical region-wide → always consolidate to the region page.
// - Other steps self-canonicalize only when a comune overlay exists, else
//   consolidate to the national guide (duplicate-content safeguard).
const canonical = isSSN
  ? new URL(`/regions/${region.slug}/residency/${SSN}`, Astro.site).href
  : note
    ? undefined
    : new URL(`/eu-citizens/residency/${entry.id}`, Astro.site).href;

const place = {
  kind: 'city' as const,
  name: city.name,
  regionName: region.name,
  navBase: `/cities/${city.slug}/residency`,
  citySlug: city.slug,
};

// SSN guidance is regional, so its local heading names the region, not the city.
const localHeading = isSSN ? `In ${region.name}` : `In ${city.name}`;

const fallbacks: Record<string, string> = {
  'codice-fiscale': `The codice fiscale is issued the same way everywhere in Italy by the Agenzia delle Entrate — there is no ${city.name}-specific procedure. The only local element is which territorial Agenzia delle Entrate office serves your address (province of ${city.province}); use the Agenzia delle Entrate office finder or apply at any office. The full procedure is in the national guide above.`,
  'iscrizione-anagrafica': `Residency registration is run by the Comune di ${city.name} through its Ufficio Anagrafe, following the national rules above — but the office, booking system and exact forms are local. Check the Comune di ${city.name} website. We don't yet have a verified ${city.name} guide for this step.`,
  'identita-digitale': `SPID and the CIE are national. SPID is obtained entirely online from an accredited provider, with no ${city.name}-specific step; the CIE — which doubles as a digital identity — is issued by the Comune di ${city.name} Ufficio Anagrafe by appointment, following the uniform national procedure above. The only local part is booking your CIE appointment with the comune.`,
  'conto-corrente': `Banking rules are national — the right to a conto di base, the documents required, and the stamp-duty thresholds are the same everywhere in Italy. There is no ${city.name}-specific procedure; simply choose a bank with a branch (or an online offering) convenient to you in ${city.name}.`,
  'patente-di-guida': `Licence validity and conversion rules are national. The only local element is which Ufficio della Motorizzazione Civile serves the province of ${city.province} — book and submit your conversion file there, following the uniform national procedure above.`,
  'residenza-fiscale': `Tax residency is defined by national law (art. 2 TUIR) — nothing about it is specific to ${city.name}. The only local element is which territorial Agenzia delle Entrate office serves your address for in-person matters; filings are national and online.`,
  'familiari-non-ue': `The residence card for non-EU family members follows the uniform national procedure above. Locally, applications go to the Questura of the province of ${city.province}; check its website for booking or postal-kit instructions.`,
};
const localFallback = fallbacks[entry.id] ?? '';
---

<GuideLayout
  entry={entry}
  place={place}
  localNote={note}
  localHeading={localHeading}
  localFallback={localFallback}
  canonical={canonical}
>
  <Content />
  {NoteContent && <NoteContent slot="local-note" />}
</GuideLayout>
