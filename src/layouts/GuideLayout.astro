---
import BaseLayout from './BaseLayout.astro';
import DocumentChecklist from '../components/DocumentChecklist.astro';
import FreshnessBadge from '../components/FreshnessBadge.astro';
import JourneyNav from '../components/JourneyNav.astro';
import CitySelector from '../components/CitySelector.astro';
import ReportIssue from '../components/ReportIssue.astro';
import SourceList from '../components/SourceList.astro';
import SourceNote from '../components/SourceNote.astro';
import SsnCostEstimator from '../components/SsnCostEstimator.astro';
import StepIcon from '../components/StepIcon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getLocale, ui } from '../i18n/ui';
import { guideSlug } from '../lib/guides';
import { getFileHistory, getFirstPublished } from '../lib/updates';
import { breadcrumbNode, guideNodes } from '../lib/schema';
import { glossary } from '../data/glossary';

/** A place context (a region or a city) that scopes the guide. */
export interface Place {
  kind: 'region' | 'city';
  name: string;
  /** For a city: the region it belongs to (shown for orientation). */
  regionName?: string;
  /** URL base for journey navigation, e.g. /cities/firenze/residency */
  navBase: string;
  /** Slug, used to pre-select the city selector. */
  citySlug?: string;
}

type LocalNote = CollectionEntry<'regionNotes'> | CollectionEntry<'comuneNotes'>;

interface Props {
  entry: CollectionEntry<'guides'>;
  place?: Place;
  /** The overlay (region or comune) rendered in the local section, if any. */
  localNote?: LocalNote;
  /** Heading for the local section, e.g. "In Firenze" or "In Toscana". */
  localHeading?: string;
  /** Shown in the local section when there is no overlay. */
  localFallback?: string;
  /** Canonical URL override (thin place pages consolidate to a parent page). */
  canonical?: string;
}
const { entry, place, localNote, localHeading, localFallback, canonical } = Astro.props;
const { data } = entry;
const url = new URL(Astro.url.pathname, Astro.site).href;

const locale = getLocale(Astro.url);
const t = ui[locale].guide;
const homeHref = locale === 'it' ? '/it' : '/';
const journeyBase =
  place?.navBase ?? (locale === 'it' ? '/it/eu-citizens/residency' : '/eu-citizens/residency');
const journeyHome = `${journeyBase}/codice-fiscale`;

// Guide pages have en/it twins at the mirrored path (national, region, and
// city routes are generated per locale from the same-slug guide). Emit
// hreflang pairs on pages that are canonical to themselves AND whose twin
// actually exists — a guide not yet translated must not declare alternates.
// Pages that consolidate their canonical elsewhere never declare them.
const slug = guideSlug(entry);
const twinLang = locale === 'en' ? 'it' : 'en';
const twinExists = (await getCollection('guides')).some(
  (g) => g.data.lang === twinLang && guideSlug(g) === slug,
);
const path = Astro.url.pathname;
const enPath = locale === 'it' ? path.replace(/^\/it(\/|$)/, '/') : path;
const alternates =
  canonical || !twinExists
    ? undefined
    : { en: enPath, it: `/it${enPath === '/' ? '' : enPath}` };

const placeLabel = place
  ? place.kind === 'city' && place.regionName
    ? `${place.name} · ${place.regionName}`
    : place.name
  : '';

// Head/OG title only — the visible <h1> stays `data.title`, and the place is
// shown in the eyebrow and breadcrumb. Place-led rather than place-suffixed:
// the city is the one word that distinguishes this page from the 20 other
// copies of the same guide, and a suffixed title put it past the point where a
// SERP snippet stops. The region is dropped for the same reason — it added up
// to 18 characters ("Trentino-Alto Adige") and disambiguates nothing, since
// city slugs are unique site-wide.
const title = place ? `${place.name} — ${data.shortTitle ?? data.title}` : data.title;
// Two different jobs, so two different strings. `data.description` is the lede
// under the <h1>, written for someone already reading; `metaDescription` is the
// snippet, written for someone deciding whether to click and capped at what
// Google shows. Where a guide has not been given one the lede stands in, which
// is what the whole site did before — 187 of 218 indexable pages sent a
// description longer than the ~160 characters a snippet displays, so the last
// clause was always thrown away.
//
// Place copies lead with the place rather than appending "Local guidance for
// X.", for the same reason the titles do: a suffix is the part that gets cut,
// and the city is the word that makes this page worth the click over the
// national one.
const metaBase = data.metaDescription ?? data.description;
// An em dash rather than a colon, so the sentence that follows keeps its own
// capital: "Bergamo: How EU/EEA citizens…" reads like a typo.
const description = place ? `${place.name} — ${metaBase}` : metaBase;

const sources = localNote ? [...data.sources, ...localNote.data.sources] : data.sources;
// A place page shows the national guide *and* the local overlay, so the date it
// can honestly claim is the older of the two — the same rule `reviewBy` below
// already used. The previous expression compared the two and then returned the
// overlay's date either way, so 110 city and region pages advertised the
// overlay's later date while still rendering national text verified weeks
// earlier. On a site whose whole contract is "dated and sourced", a date that
// rounds in our favour is the one defect that must never ship.
const lastVerified =
  localNote && localNote.data.lastVerified < data.lastVerified
    ? localNote.data.lastVerified
    : data.lastVerified;
const reviewBy =
  localNote && localNote.data.reviewBy < data.reviewBy
    ? localNote.data.reviewBy
    : data.reviewBy;

const crumbs = [
  { name: t.home, url: new URL(homeHref, Astro.site).href },
  { name: t.residency, url: new URL(journeyHome, Astro.site).href },
  ...(place ? [{ name: placeLabel, url }] : []),
  { name: data.title, url },
];
// Previous/next step in the journey, for the footer pager (internal linking
// + a clear reading path). Links stay within the current place context.
const journeySteps = (await getCollection('guides', ({ data: d }) => d.lang === locale)).sort(
  (a, b) => a.data.step - b.data.step,
);
const stepIndex = journeySteps.findIndex((g) => guideSlug(g) === guideSlug(entry));
const pager = {
  prev: stepIndex > 0 ? journeySteps[stepIndex - 1] : undefined,
  next: stepIndex >= 0 && stepIndex < journeySteps.length - 1 ? journeySteps[stepIndex + 1] : undefined,
};

// Verification history (git-derived, see scripts/build-history.mjs) for the
// page's binding document: the local overlay when there is one, else the
// national guide.
const historyKey = localNote
  ? `${localNote.collection === 'regionNotes' ? 'region-notes' : 'comune-notes'}/${localNote.id}.md`
  : `guides/${entry.id}.md`;
const historyEvents = getFileHistory(historyKey);
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
const updatesHref = locale === 'it' ? '/it/updates' : '/updates';

// The guide's H2 sections — used as HowTo steps in the structured data and
// as the on-page table of contents. Anchor slugs mirror Astro's markdown
// heading ids (github-slugger): lowercase, punctuation stripped, spaces → -.
const slugify = (s: string) =>
  s
    .toLowerCase()
    .trim()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .replace(/\s+/g, '-');
const sections = [...(entry.body ?? '').matchAll(/^## +(.+?) *$/gm)].map((m) => {
  const name = m[1].replace(/[*_`]/g, '');
  return { name, anchor: slugify(name) };
});

// Glossary terms actually used on this page (display-only cross-linking):
// a term matches when any of its name variants appears in the guide body.
const bodyLower = (entry.body ?? '').toLowerCase();
const termsOnPage = glossary
  .filter((term) =>
    term.term
      .split(/[/(),]| vs\.? /)
      .map((v) => v.trim().toLowerCase())
      .some((v) => v.length > 3 && bodyLower.includes(v)),
  )
  .slice(0, 8);
const glossaryHref = locale === 'it' ? '/it/glossary' : '/glossary';

// Structured data hangs off the canonical URL, not this page's own: a city page
// that consolidates into the national guide must not describe itself as a
// separate thing at a separate id, or the graph asserts what the canonical
// denies.
const canonicalUrl = canonical ?? url;
const schemaNodes = [
  ...guideNodes({
    canonical: canonicalUrl,
    site: Astro.site!.href,
    title,
    description,
    dateModified: lastVerified.toISOString().slice(0, 10),
    datePublished: getFirstPublished(historyKey),
    inLanguage: locale,
    steps: sections.map((s) => s.name),
    faq: data.faq,
  }),
  breadcrumbNode(canonicalUrl, crumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternates}
  ogType="article"
  modified={lastVerified}
  ogImage={`/og/${locale === 'it' ? 'it/' : ''}${slug}.png`}
  schema={schemaNodes}
  datePublished={getFirstPublished(historyKey)}
>
  <nav class="mb-6 text-sm text-muted" aria-label="Breadcrumb">
    <a href={homeHref} class="hover:text-ink">{t.home}</a>
    <span class="px-1">/</span>
    <span>{t.euCitizens}</span>
    <span class="px-1">/</span>
    {
      place ? (
        <>
          <a href={journeyHome} class="hover:text-ink">{t.residency}</a>
          <span class="px-1">/</span>
          <span class="text-ink">{placeLabel}</span>
        </>
      ) : (
        <span class="text-ink">{t.residency}</span>
      )
    }
  </nav>

  <div class="mb-6">
    <p class="flex items-center gap-2 text-sm font-medium uppercase tracking-wide text-link">
      <StepIcon slug={slug} class="h-5 w-5 text-brand-500" />
      {t.stepLabel(data.step)}{place ? ` · ${placeLabel}` : ''}
    </p>
    <h1 class="mt-2 text-4xl font-semibold">{data.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">{data.description}</p>
    <div class="mt-4">
      <FreshnessBadge lastVerified={lastVerified} reviewBy={reviewBy} />
      {
        historyEvents.length > 0 && (
          <p class="mt-2 text-sm text-muted">
            {t.historySummary(historyEvents.length, fmtDate(historyEvents[0].verified))}
            <a href={updatesHref} class="text-brand-700 underline underline-offset-2 hover:text-brand-500">
              {t.allUpdates}
            </a>
          </p>
        )
      }
    </div>
  </div>

  <div class="mb-8 print:hidden">
    <CitySelector currentGuide={slug} currentCity={place?.citySlug} />
  </div>

  <div class="mb-10 print:hidden">
    <JourneyNav currentId={entry.id} base={journeyBase} />
  </div>

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_230px] lg:gap-12">
    <div class="min-w-0">
      <article class="prose">
        <slot />
      </article>

      <SourceNote module={slug} />

      {slug === 'servizio-sanitario' && <SsnCostEstimator />}

      {
        place && (
          <section
            id="local-specifics"
            class="mt-10 rounded-lg border-l-4 border-brand-500 bg-brand-50/60 p-6"
          >
            <h2 class="font-serif text-2xl">{localHeading ?? `In ${place.name}`}</h2>
            {localNote ? (
              <div class="prose mt-3">
                <slot name="local-note" />
              </div>
            ) : (
              <p class="mt-3 text-muted">{localFallback}</p>
            )}
          </section>
        )
      }

      {
        data.documents.length > 0 && (
          <div class="mt-10">
            <DocumentChecklist id={entry.id} items={data.documents} />
          </div>
        )
      }

      {
        data.faq.length > 0 && (
          <section id="faq" class="mt-10">
            <h2 class="font-serif text-2xl">{t.faqHeading}</h2>
            <div class="mt-4 divide-y divide-line rounded-lg border border-line bg-surface/60">
              {data.faq.map((item) => (
                <details class="group px-5 py-4">
                  <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 font-medium marker:hidden [&::-webkit-details-marker]:hidden">
                    {item.q}
                    <span
                      class="select-none text-brand-500 transition-transform group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p class="mt-2 max-w-prose text-muted">{item.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        termsOnPage.length > 0 && (
          <section class="mt-10 print:hidden" aria-label={t.termsHeading}>
            <h2 class="text-sm font-medium uppercase tracking-wide text-muted">{t.termsHeading}</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {termsOnPage.map((term) => (
                <li>
                  <a
                    href={`${glossaryHref}#${term.slug}`}
                    class="inline-block rounded-full border border-line bg-surface/60 px-3 py-1 text-sm text-brand-700 transition hover:border-brand-300"
                  >
                    {term.term}
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm">
              <a href={glossaryHref} class="text-brand-700 underline underline-offset-2">
                {t.glossaryAll}
              </a>
            </p>
          </section>
        )
      }

      <SourceList sources={sources} />

      {
        (pager.prev || pager.next) && (
          <nav class="mt-10 grid gap-3 sm:grid-cols-2 print:hidden" aria-label={`${t.prevStep} / ${t.nextStep}`}>
            {pager.prev ? (
              <a
                href={`${journeyBase}/${guideSlug(pager.prev)}`}
                class="group rounded-lg border border-line bg-surface/60 p-4 transition hover:border-brand-300"
              >
                <span class="text-xs font-medium uppercase tracking-wide text-muted">
                  ← {t.prevStep} · {pager.prev.data.step}
                </span>
                <span class="mt-1 block font-serif text-lg group-hover:text-brand-700">
                  {pager.prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {pager.next && (
              <a
                href={`${journeyBase}/${guideSlug(pager.next)}`}
                class="group rounded-lg border border-line bg-surface/60 p-4 text-right transition hover:border-brand-300"
              >
                <span class="text-xs font-medium uppercase tracking-wide text-muted">
                  {t.nextStep} · {pager.next.data.step} →
                </span>
                <span class="mt-1 block font-serif text-lg group-hover:text-brand-700">
                  {pager.next.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }

      <div class="print:hidden">
        <ReportIssue pageTitle={title} pageUrl={url} />
      </div>
    </div>

    {
      sections.length > 0 && (
        <aside class="hidden lg:block print:hidden" aria-label={t.tocHeading}>
          <nav class="sticky top-8 border-l border-line pl-5 text-sm">
            <p class="font-medium uppercase tracking-wide text-muted">{t.tocHeading}</p>
            <ul class="mt-3 space-y-2">
              {sections.map((s) => (
                <li>
                  <a href={`#${s.anchor}`} class="text-muted transition hover:text-brand-700">
                    {s.name}
                  </a>
                </li>
              ))}
              {data.faq.length > 0 && (
                <li>
                  <a href="#faq" class="text-muted transition hover:text-brand-700">
                    {t.faqHeading}
                  </a>
                </li>
              )}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>
