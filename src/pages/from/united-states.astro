---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageSources from '../../components/PageSources.astro';
import { getSourceCountry, moduleUrl } from '../../data/source-countries';

// Per-source-country hub. The body is assembled from the notes registered in
// src/data/source-countries.ts, so adding a verified note to a module also
// enriches this page — there is no second copy of the facts to drift.
const country = getSourceCountry('united-states')!;
const notes = country.notes;
// Deduplicated union of every note's sources, so the page cites exactly what it
// rests on and nothing more.
const sources = [...new Map(notes.flatMap((n) => n.sources).map((s) => [s.url, s])).values()];
const moduleTitle: Record<string, string> = {
  '/driving': 'Driving',
  '/pets': 'Pets',
  '/non-eu': 'Non-EU orientation',
  'residenza-fiscale': 'Tax residency',
  'servizio-sanitario': 'Health service',
  'codice-fiscale': 'Codice fiscale',
};
---

<BaseLayout
  title="Moving to Italy from the United States"
  description="What differs for Americans: the licence that cannot be converted, documents that need a state apostille, and US tax duties abroad."
  alternates={{ en: '/from/united-states', it: '/it/from/united-states' }}
  ogImage="/og/from-united-states.png"
  citations={sources}
>
  <nav class="mb-6 text-sm text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink">Home</a>
    <span class="px-1">/</span>
    <span class="text-ink">From the United States</span>
  </nav>

  <div class="prose">
    <h1>Moving to Italy from the United States</h1>
    <p>
      Most of this site is organised by <em>destination</em> — the national
      procedure, then your region, then your comune. This page collects what
      differs because of where you are coming <em>from</em>. Facts verified on
      the dates shown against each item; orientation, not legal, tax or
      immigration advice.
    </p>
    <p>
      Start with the <a href="/non-eu">non-EU orientation</a>, which covers the
      visa routes themselves — a US passport lets you <strong>visit</strong>
      Schengen without a visa, which is not the same as being allowed to
      <strong>move</strong> there.
    </p>

    <h2>What is different for Americans</h2>
  </div>

  <ul class="mt-5 grid gap-3">
    {
      notes.map((note) => (
        <li class="rounded-xl border border-line bg-surface/60 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-serif text-lg text-brand-700">{note.headingEn}</h3>
            <span class="text-xs text-muted">
              {moduleTitle[note.module] ?? note.module} · verified{' '}
              <time datetime={note.lastVerified}>{note.lastVerified}</time>
            </span>
          </div>
          <p class="mt-2 text-sm">{note.en}</p>
          <a href={moduleUrl(note.module)} class="mt-3 inline-block text-sm text-link underline underline-offset-2">
            Full page on {(moduleTitle[note.module] ?? note.module).toLowerCase()} →
          </a>
        </li>
      ))
    }
  </ul>

  <div class="prose mt-10">
    <h2>Two topics with enough substance for their own page</h2>
  </div>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
    <li class="rounded-xl border border-line bg-surface/60 p-5">
      <a href="/from/united-states/arriving" class="font-serif text-lg text-brand-700 hover:underline">Arriving from the United States</a>
      <p class="mt-1 text-sm text-muted">Why 90 days visa-free is not a relocation route, which consulate has your state, the apostille chain, and the one-year driving clock.</p>
    </li>
    <li class="rounded-xl border border-line bg-surface/60 p-5">
      <a href="/from/united-states/taxes" class="font-serif text-lg text-brand-700 hover:underline">US taxes and social security</a>
      <p class="mt-1 text-sm text-muted">Worldwide filing, the exclusion versus the credit, FBAR and Form 8938, the treaty's saving clause, and why Medicare stops at the border.</p>
    </li>
  </ul>

  <div class="prose mt-10">
    <h2>What is the same</h2>
    <p>
      Plenty. The <a href="/eu-citizens/residency/codice-fiscale">codice
      fiscale</a> is free and identical for everyone. The
      <a href="/renting">rental rules</a> — contract types, the 30-day
      registration duty, the three-month deposit cap — do not vary by
      nationality. <a href="/schools">School enrolment</a> is a right for every
      minor in Italy regardless of the family's status or paperwork, and can be
      requested at any point in the year. Where a page carries no note above,
      that is the reason: there is nothing US-specific to say, and inventing a
      difference would be worse than silence.
    </p>

    <h2>How this page is maintained</h2>
    <p>
      Each item above is a separately dated entry with its own primary sources,
      re-verified on its own schedule rather than as one undated blob — the same
      contract as the rest of the site. Every re-check is logged on the
      <a href="/updates">updates page</a>.
    </p>
  </div>

  <PageSources sources={sources} intro="Primary, official sources the items above rest on — each fetched and checked on the date shown against its item." />
</BaseLayout>
