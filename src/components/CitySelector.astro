---
import { citiesByRegion } from '../data/cities';
import { getLocale } from '../i18n/ui';

/**
 * Lets the visitor pick a city/comune and jump to the city-specific version of
 * the current guide step. Cities are grouped by region (optgroup), so it is
 * always clear which region a settlement sits in. The choice is remembered
 * (localStorage) so other pages can default to it. Locale-aware: navigates
 * within /it/ when the page is Italian.
 */
interface Props {
  /** Guide id to navigate to within the chosen city. */
  currentGuide?: string;
  /** Currently-selected city slug, if any. */
  currentCity?: string;
}
const { currentGuide = 'codice-fiscale', currentCity } = Astro.props;
const groups = citiesByRegion();

const locale = getLocale(Astro.url);
const prefix = locale === 'it' ? '/it' : '';
const txt =
  locale === 'it'
    ? { label: '📍 La tua città / comune', choose: 'Scegli una città…', go: 'Vai', browse: 'Sfoglia tutte', national: 'Guida nazionale' }
    : { label: '📍 Your city / comune', choose: 'Choose a city…', go: 'Go', browse: 'Browse all', national: 'National guide' };
---

<form
  class="not-prose flex flex-wrap items-center gap-3 rounded-lg border border-line bg-surface/70 px-4 py-3"
  data-city-selector
  data-prefix={prefix}
  data-current-guide={currentGuide}
>
  <label for="city-select" class="text-sm font-medium">{txt.label}</label>
  <select
    id="city-select"
    data-city-select
    class="min-w-56 rounded-md border border-line bg-surface px-3 py-1.5 text-sm focus:border-brand-500 focus:outline-none"
  >
    <option value="">{txt.choose}</option>
    {
      groups.map((g) => (
        <optgroup label={g.region.name}>
          {g.cities.map((c) => (
            <option value={c.slug} selected={c.slug === currentCity}>
              {c.name} ({c.province})
            </option>
          ))}
        </optgroup>
      ))
    }
  </select>
  <button
    type="submit"
    class="rounded-md bg-fill px-4 py-1.5 text-sm text-onfill transition hover:bg-fill-hover"
  >
    {txt.go}
  </button>
  <a href={`${prefix}/cities`} class="text-sm text-muted underline">{txt.browse}</a>
  {
    currentCity && (
      <a href={`${prefix}/eu-citizens/residency/codice-fiscale`} class="text-sm text-muted underline">
        {txt.national}
      </a>
    )
  }
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-city-selector]').forEach((root) => {
    const select = root.querySelector<HTMLSelectElement>('[data-city-select]');
    if (!select) return;

    // Restore a previously chosen city when the page hasn't set one.
    if (!select.value) {
      try {
        const saved = localStorage.getItem('city');
        if (saved) select.value = saved;
      } catch {
        /* localStorage unavailable */
      }
    }

    // Navigate on explicit submit (Go button / Enter) — not on change, so
    // keyboard and screen-reader users can browse options freely.
    root.addEventListener('submit', (e) => {
      e.preventDefault();
      const slug = select.value;
      if (!slug) return;
      try {
        localStorage.setItem('city', slug);
      } catch {
        /* ignore */
      }
      const guide = root.dataset.currentGuide || 'codice-fiscale';
      const prefix = root.dataset.prefix || '';
      window.location.href = `${prefix}/cities/${slug}/residency/${guide}`;
    });
  });
</script>
