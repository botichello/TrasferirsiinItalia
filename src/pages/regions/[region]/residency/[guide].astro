---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../../layouts/GuideLayout.astro';
import { regions, getRegion } from '../../../../data/regions';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => data.lang === 'en');
  const notes = await getCollection('regionNotes');

  return regions.flatMap((region) =>
    guides.map((entry) => {
      const regionNote = notes.find(
        (n) => n.data.region === region.slug && n.data.guide === entry.id,
      );
      return {
        params: { region: region.slug, guide: entry.id },
        props: { entry, regionSlug: region.slug, regionNote },
      };
    }),
  );
}

const { entry, regionSlug, regionNote } = Astro.props;
const region = getRegion(regionSlug)!;

const { Content } = await render(entry);
const RegionNoteContent = regionNote ? (await render(regionNote)).Content : null;

// Duplicate-content safeguard: a region page is only canonical to itself when it
// carries a substantive region overlay. Otherwise it consolidates to the
// national guide so search engines don't treat ~identical pages as duplicates.
const canonical = regionNote
  ? undefined
  : new URL(`/eu-citizens/residency/${entry.id}`, Astro.site).href;

const place = {
  kind: 'region' as const,
  name: region.name,
  navBase: `/regions/${region.slug}/residency`,
};
const localFallback = `This step follows the national procedure described above. We don't yet have verified ${region.name}-specific details for it — the comune where you live (and, for the health service, your local health authority) handle the local specifics, so confirm with them. A verified ${region.name} guide for this step is on the way.`;
---

<GuideLayout
  entry={entry}
  place={place}
  localNote={regionNote}
  localHeading={`In ${region.name}`}
  localFallback={localFallback}
  canonical={canonical}
>
  <Content />
  {RegionNoteContent && <RegionNoteContent slot="local-note" />}
</GuideLayout>
