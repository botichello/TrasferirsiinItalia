---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CitySelector from '../components/CitySelector.astro';
import StepIcon from '../components/StepIcon.astro';

const steps = (await getCollection('guides', ({ data }) => data.lang === 'en'))
  .sort((a, b) => a.data.step - b.data.step)
  .map((e) => ({
    step: e.data.step,
    slug: e.id,
    title: e.data.title,
    description: e.data.description,
    href: `/eu-citizens/residency/${e.id}`,
  }));

// The journey as an ItemList, so search engines and AI agents see the steps
// as an ordered whole, not just eight unrelated links.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'EU residency journey in Italy',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: steps.length,
  itemListElement: steps.map((s) => ({
    '@type': 'ListItem',
    position: s.step,
    name: s.title,
    url: new URL(s.href, Astro.site).href,
  })),
};
---

<BaseLayout
  title="Moving to Italy as an EU citizen"
  description="A clear, dated, source-cited guide to establishing residency in Italy as an EU/EEA citizen: codice fiscale, anagrafe registration, and the national health service."
  alternates={{ en: '/', it: '/it' }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} is:inline />
  <section class="py-8 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-brand-600">
      For EU & EEA citizens
    </p>
    <h1 class="mx-auto mt-3 max-w-3xl text-5xl font-semibold leading-tight">
      Establishing residency in Italy, without the guesswork.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">
      A step-by-step reference for the national residency journey — every page
      dated and cited to official Italian and EU sources, so you (and your
      lawyer, and your search assistant) can trust it.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/start"
        class="inline-flex items-center rounded-full bg-brand-500 px-6 py-3 text-white transition hover:bg-brand-600"
      >
        Start here →
      </a>
      <a
        href="/eu-citizens/residency/codice-fiscale"
        class="text-sm text-muted underline underline-offset-2 hover:text-ink"
      >
        or jump straight to Step 1
      </a>
    </div>

    <p class="mx-auto mt-4 max-w-xl text-sm text-muted">
      Not an EU/EEA citizen?
      <a href="/non-eu" class="text-brand-700 underline underline-offset-2">Start with our non-EU orientation →</a>
    </p>

    <div class="mx-auto mt-8 max-w-xl">
      <CitySelector />
      <p class="mt-2 text-sm text-muted">
        Pick your city (grouped by region) to see local specifics — your comune's
        anagrafe office for residency, and your region's health authority for the
        SSN — layered on top of the national steps.
      </p>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="font-serif text-2xl">The residency journey</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li>
            <a
              href={s.href}
              class="flex h-full flex-col rounded-xl border border-line bg-white/60 p-6 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md hover:shadow-brand-700/5"
            >
              <span class="flex items-start justify-between">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 font-serif font-semibold text-white">
                  {s.step}
                </span>
                <StepIcon slug={s.slug} class="h-6 w-6 text-brand-500/70" />
              </span>
              <h3 class="mt-4 font-serif text-lg">{s.title}</h3>
              <p class="mt-2 text-sm text-muted">{s.description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-16">
    <h2 class="font-serif text-2xl">Beyond the journey</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        [
          ['/non-eu', 'Not an EU citizen?', 'Seven visa and permit routes covered in detail — from the digital-nomad visa to long-term residence.'],
          ['/citizenship', 'Italian citizenship', 'The residence ladder (4 years for EU citizens), marriage, and descent after the 2025 reform.'],
          ['/renting', 'Renting a home', 'Contract types, the 30-day registration rule, the 3-month deposit cap, cedolare secca.'],
          ['/schools', 'School for your children', 'Compulsory 6–16, mid-year enrolment at any time, the Unica window, what is actually free.'],
          ['/checklist', 'The full checklist', 'Every step and every document on one printable page.'],
        ].map(([href, title, blurb]) => (
          <li class="sm:last:col-span-2">
            <a
              href={href}
              class="flex h-full flex-col rounded-xl border border-line bg-white/60 p-5 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md hover:shadow-brand-700/5"
            >
              <span class="font-serif text-lg text-brand-700">{title}</span>
              <span class="mt-1 text-sm text-muted">{blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 rounded-xl border border-line bg-brand-50/50 p-8">
    <h2 class="font-serif text-2xl">Why trust this guide</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-3 text-sm">
      <div>
        <h3 class="flex items-center gap-2 font-serif text-lg">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-xs text-white" aria-hidden="true">✓</span>
          Dated
        </h3>
        <p class="mt-1 text-muted">
          Every page shows when it was last verified and when it is next due for
          review. Overdue pages are flagged, not silently trusted.
        </p>
      </div>
      <div>
        <h3 class="flex items-center gap-2 font-serif text-lg">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-xs text-white" aria-hidden="true">✓</span>
          Sourced
        </h3>
        <p class="mt-1 text-muted">
          Each page cites the primary official sources it is based on. The site
          cannot publish a page without them.
        </p>
      </div>
      <div>
        <h3 class="flex items-center gap-2 font-serif text-lg">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-xs text-white" aria-hidden="true">✓</span>
          Narrow on purpose
        </h3>
        <p class="mt-1 text-muted">
          We cover the EU national residency journey deeply rather than
          everything shallowly — so the information stays accurate.
        </p>
      </div>
    </div>
    <p class="mt-6 text-sm text-muted">
      The receipts are public: every re-verification is logged on the
      <a href="/updates" class="text-brand-700 underline underline-offset-2">updates page</a>,
      and every citation is indexed on the
      <a href="/sources" class="text-brand-700 underline underline-offset-2">sources page</a>.
    </p>
  </section>
</BaseLayout>
