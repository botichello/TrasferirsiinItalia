---
import '../styles/global.css';
import { getLocale, ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Override the canonical URL (e.g. a region page that consolidates to the
   *  national guide when it has no substantive region-specific content). */
  canonical?: string;
  /** Root-relative paths to the en/it twins of this page, for hreflang. */
  alternates?: { en: string; it: string };
}
const { title, description, canonical: canonicalOverride, alternates } = Astro.props;
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Trasferirsi in Italia';

const locale = getLocale(Astro.url);
const t = ui[locale];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site?.href,
  description:
    'A free, source-cited reference for relocating to Italy, covering the EU/EEA residency journey at national, regional, and comune level.',
};

const homeHref = locale === 'en' ? '/' : '/it';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site).href} />
          <link rel="alternate" hreflang="it" href={new URL(alternates.it, Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgSchema)}
      is:inline
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
    >
      {t.skip}
    </a>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-5 py-4">
        <a href={homeHref} class="font-serif text-lg font-semibold text-ink">
          Trasferirsi <span class="text-brand-600">in Italia</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Primary">
          {t.nav.map((item) => (
            <a href={item.href} class="text-muted hover:text-ink">{item.label}</a>
          ))}
          <a
            href={t.switchHref}
            class="rounded-full border border-line px-2 py-0.5 text-muted hover:border-brand-300 hover:text-brand-700"
            hreflang={locale === 'en' ? 'it' : 'en'}
          >
            {t.switchLabel}
          </a>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-5xl px-5 py-8 text-sm text-muted">
        <nav class="mb-4 flex flex-wrap gap-x-4 gap-y-1" aria-label="Footer">
          {t.footerNav.map((item) => (
            <a href={item.href} class="hover:text-ink">{item.label}</a>
          ))}
        </nav>
        <p>{t.disclaimer}</p>
        <p class="mt-2">© {new Date().getFullYear()} Trasferirsi in Italia</p>
      </div>
    </footer>
  </body>
</html>
