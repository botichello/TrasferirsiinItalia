---
import { regions } from '../data/regions';

/**
 * Lets the visitor pick an Italian region and jump to the region-specific
 * version of the current guide step. The choice is remembered (localStorage)
 * so other pages can default to it.
 */
interface Props {
  /** Guide id to navigate to within the chosen region. */
  currentGuide?: string;
  /** Currently-selected region slug, if any. */
  currentRegion?: string;
}
const { currentGuide = 'codice-fiscale', currentRegion } = Astro.props;
---

<div
  class="not-prose flex flex-wrap items-center gap-3 rounded-lg border border-line bg-white/70 px-4 py-3"
  data-region-selector
  data-current-guide={currentGuide}
>
  <label for="region-select" class="text-sm font-medium">
    📍 Your region in Italy
  </label>
  <select
    id="region-select"
    data-region-select
    class="rounded-md border border-line bg-white px-3 py-1.5 text-sm focus:border-brand-500 focus:outline-none"
  >
    <option value="">Choose a region…</option>
    {
      regions.map((r) => (
        <option value={r.slug} selected={r.slug === currentRegion}>
          {r.name}
        </option>
      ))
    }
  </select>
  {
    currentRegion && (
      <a href="/eu-citizens/residency/codice-fiscale" class="text-sm text-muted underline">
        View national guide
      </a>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-region-selector]').forEach((root) => {
    const select = root.querySelector<HTMLSelectElement>('[data-region-select]');
    if (!select) return;

    // Pre-select a previously chosen region when the page hasn't already set one.
    if (!select.value) {
      try {
        const saved = localStorage.getItem('region');
        if (saved) select.value = saved;
      } catch {
        /* localStorage unavailable */
      }
    }

    select.addEventListener('change', () => {
      const slug = select.value;
      if (!slug) return;
      try {
        localStorage.setItem('region', slug);
      } catch {
        /* ignore */
      }
      const guide = root.dataset.currentGuide || 'codice-fiscale';
      window.location.href = `/regions/${slug}/residency/${guide}`;
    });
  });
</script>
