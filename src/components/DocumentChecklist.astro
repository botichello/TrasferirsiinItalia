---
/**
 * Interactive document checklist. Progress is saved to localStorage per
 * checklist id, so a newcomer can tick items off across visits. Renders as
 * plain checkboxes without JS (progressive enhancement).
 */
import { getLocale, ui } from '../i18n/ui';

interface Props {
  id: string;
  items: string[];
}
const { id, items } = Astro.props;
const t = ui[getLocale(Astro.url)].guide;
---

<div class="not-prose rounded-lg border border-line bg-surface/70 p-6" data-checklist={id}>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-serif text-lg">{t.documents}</h3>
    <button
      type="button"
      data-checklist-reset
      class="text-sm text-muted underline underline-offset-2 hover:text-ink"
    >
      {t.reset}
    </button>
  </div>
  <ul class="mt-4 space-y-2">
    {
      items.map((item, i) => (
        <li>
          <label class="flex cursor-pointer items-start gap-3 text-sm">
            <input
              type="checkbox"
              data-checklist-item={String(i)}
              class="mt-0.5 h-4 w-4 accent-[var(--color-brand-500)]"
            />
            <span>{item}</span>
          </label>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((root) => {
    const key = `checklist:${root.dataset.checklist}`;
    const boxes = root.querySelectorAll<HTMLInputElement>('[data-checklist-item]');

    let saved: Record<string, boolean> = {};
    try {
      saved = JSON.parse(localStorage.getItem(key) ?? '{}');
    } catch {
      saved = {};
    }

    // Writes are guarded like the reads. localStorage.setItem throws outright
    // when storage is blocked (privacy modes, "block all cookies", quota), and
    // an unguarded write here would surface as an uncaught exception on every
    // single checkbox toggle. The checklist itself still works without
    // persistence, so failing to save must stay silent.
    const persist = () => {
      const state: Record<string, boolean> = {};
      boxes.forEach((b) => (state[b.dataset.checklistItem!] = b.checked));
      try {
        localStorage.setItem(key, JSON.stringify(state));
      } catch {
        /* storage unavailable — ticking still works, it just will not persist */
      }
    };

    boxes.forEach((b) => {
      b.checked = Boolean(saved[b.dataset.checklistItem!]);
      b.addEventListener('change', persist);
    });

    root
      .querySelector<HTMLButtonElement>('[data-checklist-reset]')
      ?.addEventListener('click', () => {
        boxes.forEach((b) => (b.checked = false));
        try {
          localStorage.removeItem(key);
        } catch {
          /* as above */
        }
      });
  });
</script>
