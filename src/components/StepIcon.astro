---
/**
 * Line icon for a journey step, keyed by guide slug. Hand-drawn 24×24 stroke
 * paths in the site's restrained style — inline SVG, no icon library.
 */
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<string, string[]> = {
  // ID card
  'codice-fiscale': [
    'M2.5 5.5h19a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-19a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z',
    'M8 11.2a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8z',
    'M4.8 16c.4-1.9 2-2.7 3.2-2.7s2.8.8 3.2 2.7',
    'M14 9.5h5.5M14 13h4',
  ],
  // house
  'iscrizione-anagrafica': [
    'M3 11.5 12 4l9 7.5',
    'M5.5 10.2V19.5h13v-9.3',
    'M10 19.5v-5.2h4v5.2',
  ],
  // health cross
  'servizio-sanitario': [
    'M3.5 6.5a3 3 0 0 1 3-3h11a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3h-11a3 3 0 0 1-3-3v-11z',
    'M12 8v8M8 12h8',
  ],
  // shield + check
  'identita-digitale': [
    'M12 3l7 2.8v6c0 4.4-2.9 7.4-7 9.2-4.1-1.8-7-4.8-7-9.2v-6L12 3z',
    'M9 12l2.2 2.2L15.5 10',
  ],
  // bank
  'conto-corrente': [
    'M12 3.5 3 9.5h18l-9-6z',
    'M5 9.5v8M9.7 9.5v8M14.3 9.5v8M19 9.5v8',
    'M3.5 20.5h17',
  ],
  // car
  'patente-di-guida': [
    'M4.5 15.5l1.6-4.7A2 2 0 0 1 8 9.5h8a2 2 0 0 1 1.9 1.3l1.6 4.7',
    'M3.5 15.5h17v4h-2.8v-1.6H6.3v1.6H3.5v-4z',
  ],
  // percent
  'residenza-fiscale': [
    'M7 9.5a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8z',
    'M17 19.3a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8z',
    'M18.5 5.5l-13 13',
  ],
  // two people
  'familiari-non-ue': [
    'M9 10.8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
    'M3.5 19.5c0-3.1 2.4-4.7 5.5-4.7s5.5 1.6 5.5 4.7',
    'M16.3 11.4a2.4 2.4 0 1 0 0-4.8',
    'M16.5 14.9c2.4.2 4 1.7 4 4.1',
  ],
};

const d = paths[slug];
---

{
  d && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      {d.map((p) => (
        <path d={p} />
      ))}
    </svg>
  )
}
