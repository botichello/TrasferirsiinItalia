  { title: 'Normattiva — D.Lgs. 286/1998, art. 27-quater (criteri di alta qualificazione)', url: 'https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legislativo:1998-07-25;286~art27quater!vig=' },
  { title: "Ambasciata d'Italia Pristina — Visto per nomadi digitali e lavoratori da remoto", url: 'https://ambpristina.esteri.it/en/servizi-consolari-e-visti/servizi-per-il-cittadino-straniero/visti/visto-per-nomadi-digitali-e-lavoratori-da-remoto/' },
  { title: "Consolato Generale d'Italia New York — Digital Nomad / Remote Worker visa", url: 'https://consnewyork.esteri.it/en/servizi-consolari-e-visti/servizi-per-il-cittadino-straniero/visti/visas-to-enter-italy/digital-nomad-remote-worker-visa/' },
  { title: 'Integrazione Migranti (Ministero del Lavoro) — Nomadi digitali: le regole', url: 'https://integrazionemigranti.gov.it/it-it/Ricerca-news/Dettaglio-news/id/3736/Nomadi-digitali-e-lavoratori-da-remoto-ecco-le-regole' },
