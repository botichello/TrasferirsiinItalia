---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepIcon from '../../components/StepIcon.astro';
import { guideSlug } from '../../lib/guides';

const steps = (await getCollection('guides', ({ data }) => data.lang === 'it')).sort(
  (a, b) => a.data.step - b.data.step,
);
const lastVerified = new Date(
  Math.min(...steps.map((s) => s.data.lastVerified.getTime())),
);
---

<BaseLayout
  title="La checklist completa del percorso"
  description="Tutti i passi del percorso di residenza UE e tutti i documenti da portare, in una sola pagina stampabile — composta dalle guide verificate e con fonti."
  alternates={{ en: '/checklist', it: '/it/checklist' }}
  ogImage="/og/it/checklist.png"
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-4xl font-semibold">La checklist completa del percorso</h1>
      <p class="mt-3 max-w-2xl text-muted">
        Tutti gli otto passi e ogni documento da portare, in una sola pagina.
        Stampala, spunta man mano, e apri la guida di ogni passo per la procedura
        completa e verificata. Contenuti tratti da guide verificate non prima del
        <time datetime={lastVerified.toISOString().slice(0, 10)}>{lastVerified.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}</time>.
      </p>
    </div>
    <button
      data-print
      class="rounded-full border border-brand-600 px-5 py-2 text-sm font-medium text-brand-700 transition hover:bg-brand-50 print:hidden"
    >
      Stampa la checklist
    </button>
  </div>

  <ol class="mt-10 space-y-8">
    {
      steps.map((s) => (
        <li class="rounded-xl border border-line bg-surface/60 p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-fill font-serif font-semibold text-onfill">
              {s.data.step}
            </span>
            <StepIcon slug={guideSlug(s)} class="h-5 w-5 text-brand-500" />
            <h2 class="font-serif text-xl">
              <a href={`/it/eu-citizens/residency/${guideSlug(s)}`} class="hover:text-brand-700">
                {s.data.title}
              </a>
            </h2>
          </div>
          <p class="mt-2 text-sm text-muted">{s.data.description}</p>
          {s.data.documents.length > 0 ? (
            <ul class="mt-4 space-y-2">
              {s.data.documents.map((d) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="mt-0.5 h-4 w-4 shrink-0 rounded border border-muted" aria-hidden="true" />
                  {d}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm italic text-muted">
              Nessun documento da preparare in anticipo — vedi la guida per la procedura.
            </p>
          )}
        </li>
      ))
    }
  </ol>

  <section class="mt-10 rounded-xl border border-line bg-brand-50/50 p-6 print:border-line print:bg-transparent">
    <h2 class="font-serif text-xl">Non in checklist, ma spesso necessario</h2>
    <p class="mt-1 text-sm text-muted">
      Stanno fuori dagli otto passi, quindi non hanno caselle da spuntare — ma per
      molti bloccano o seguono il percorso.
    </p>
    <ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
      {
        [
          ['/it/renting', 'Affittare casa', 'il contratto registrato viene prima del passo 2'],
          ['/it/banking', 'Aprire un conto bancario', 'è un diritto, anche senza residenza'],
          ['/it/driving', 'Guidare con la patente estera', 'un anno se la patente è extra-UE'],
          ['/it/schools', 'Iscrivere i figli a scuola', 'possibile in qualunque periodo dell’anno'],
        ].map(([href, label, why]) => (
          <li class="flex items-baseline gap-2">
            <a href={href} class="text-brand-700 underline underline-offset-2">{label}</a>
            <span class="text-muted">— {why}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="mt-8 text-sm text-muted print:hidden">
    Uffici e prenotazioni specifici della tua città sono nelle sue pagine — scegli
    la tua da <a href="/it/cities" class="text-brand-700 underline underline-offset-2">Sfoglia città</a>.
  </p>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
